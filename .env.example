# Anthropic API Key (only required when analysisProvider is 'anthropic-api')
# Not needed when using the default 'claude-cli' or 'codex-cli' backend.
# ANTHROPIC_API_KEY=sk-ant-...

# Slack Bot Token (Bot User OAuth Token)
SUPE_SLACK_BOT_TOKEN=xoxb-...

# Slack App Token (App-Level Token for Socket Mode)
SUPE_SLACK_APP_TOKEN=xapp-...
